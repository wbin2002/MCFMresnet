{
  "experiment_name": "scratch_mcfm_resnet18_fivefold",
  "seed": 2021,
  "fold": 3,
  "model": {
    "name": "mcfm_resnet18",
    "num_classes": 4,
    "pretrained": false,
    "contrasts": [
      1.0,
      1.3,
      1.6,
      2.0
    ],
    "maps_per_contrast": 3,
    "branch_activation": "mish",
    "fusion": "gccp",
    "clip_contrast": true
  },
  "training": {
    "epochs": 20,
    "batch_size": 64,
    "learning_rate": 0.001,
    "weight_decay": 0.0,
    "checkpoint_criterion": "validation_macro_f1",
    "test_evaluations": 1
  },
  "split": {
    "train": {
      "images": 768,
      "patients_or_groups": 192,
      "class_counts": {
        "0": 192,
        "1": 192,
        "2": 192,
        "3": 192
      }
    },
    "validation": {
      "images": 192,
      "patients_or_groups": 48,
      "class_counts": {
        "0": 48,
        "1": 48,
        "2": 48,
        "3": 48
      }
    },
    "test": {
      "images": 240,
      "patients_or_groups": 60,
      "class_counts": {
        "0": 60,
        "1": 60,
        "2": 60,
        "3": 60
      }
    }
  }
}